{
  "permissions": {
    "allow": [
      "Bash(scripts/live-check.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/no-push-to-merged.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
